# Copy this file to .env (same folder) and paste your key:
#   cp .env.example .env        (macOS / Linux)
#   copy .env.example .env      (Windows)
OPENAI_API_KEY=sk-...

# Using a different OpenAI-compatible provider (Mistral, OpenRouter, Groq, a
# local Ollama server, ...)? The OpenAI SDK reads these automatically, so you
# can switch provider without touching the code:
#   OPENAI_API_KEY=<your provider's key>
#   OPENAI_BASE_URL=https://api.mistral.ai/v1
# Then change CHAT_MODEL / EMBEDDING_MODEL at the top of each script to models
# your provider offers (e.g. "mistral-small-latest" and "mistral-embed").

# Optional: point every step at your own PDF instead of the default sample.
# RAG_PDF_PATH=sample_docs/how_to_do_great_work.pdf
